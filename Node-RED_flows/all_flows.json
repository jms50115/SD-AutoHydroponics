    {
        "id": "c7381bf4a914814c",
        "type": "function",
        "z": "3879ed0278f4649f",
        "name": "Store Targets",
        "func": "if (msg.payload.status !== \"plant_set\") return null;\n\nflow.set(\"phTarget\", ((Number(msg.payload.phMin) + Number(msg.payload.phMax)) / 2));\nflow.set(\"ecTarget\", ((Number(msg.payload.ecMin) + Number(msg.payload.ecMax)) / 2));\nflow.set(\"tempTarget\", ((Number(msg.payload.tempMin) + Number(msg.payload.tempMax)) / 2));\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 220,
        "wires": [
            [
                "1e237327fa7128b9"
            ]
        ]
    },
    {
        "id": "d50e6d318f68d61a",
        "type": "function",
        "z": "3879ed0278f4649f",
        "name": "Temp function",
        "func": "if (msg.payload.tempC === undefined || msg.payload.tempC === null) return null;\n\nlet actual = Number(msg.payload.tempC);\nif (isNaN(actual)) return null;\n\nlet target = flow.get(\"tempTarget\");\nif (target === undefined || target === null) target = actual;\n\nreturn [\n    {\n        payload: actual,\n        topic: \"Temp C\"\n    },\n    {\n        payload: Number(target),\n        topic: \"Temp Target\"\n    }\n];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 40,
        "wires": [
            [
                "2f9c09d352978aac"
            ],
            [
                "2f9c09d352978aac"
            ]
        ]
    },
    {
        "id": "77f84f3ecd0cfffe",
        "type": "function",
        "z": "3879ed0278f4649f",
        "name": "pH function",
        "func": "if (msg.payload.ph === undefined || msg.payload.ph === null) return null;\n\nlet actual = Number(msg.payload.ph);\nif (isNaN(actual)) return null;\n\nlet target = flow.get(\"phTarget\");\nif (target === undefined || target === null) target = actual;\n\nreturn [\n    {\n        payload: actual,\n        topic: \"pH\"\n    },\n    {\n        payload: Number(target),\n        topic: \"pH Target\"\n    }\n];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 100,
        "wires": [
