        "func": "if (msg.payload.ec === undefined || msg.payload.ec === null) return null;\n\nlet actual = Number(msg.payload.ec);\nif (isNaN(actual)) return null;\n\nlet target = flow.get(\"ecTarget\");\nif (target === undefined || target === null) target = actual;\n\nreturn [\n    {\n        payload: actual,\n        topic: \"EC\"\n    },\n    {\n        payload: Number(target),\n        topic: \"EC Target\"\n    }\n];",
